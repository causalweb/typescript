{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "types": ["node"],
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "experimentalDecorators": true,
    "declaration": true,
    "rootDir": ".",
    "outDir": "dist",
    "skipLibCheck": false
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["test/consumer"]
}
