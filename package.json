{
  "name": "@causalweb/protocol",
  "version": "0.1.0-experimental",
  "private": true,
  "type": "module",
  "description": "Independent experimental Causal Web implementation for Node.js",
  "repository": { "type": "git", "url": "https://github.com/causalweb/typescript.git" },
  "license": "Apache-2.0 OR MIT",
  "engines": { "node": ">=24" },
  "exports": { ".": { "types": "./dist/src/index.d.ts", "import": "./dist/src/index.js" } },
  "files": ["dist/src/", "README.md", "CONFORMANCE.md", "SECURITY.md", "LICENSE.md", "LICENSES/", "SPEC_REVISION"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:package": "npm run build && node scripts/check-package.mjs"
  },
  "dependencies": { "structured-headers": "2.1.1" },
  "devDependencies": { "@types/node": "24.19.2", "typescript": "7.0.2" }
}
