{
  "name": "@causalweb/protocol",
  "version": "0.1.0-experimental",
  "private": true,
  "type": "module",
  "description": "Independent experimental Causal Web implementation for Node.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/causalweb/typescript.git"
  },
  "license": "Apache-2.0 OR MIT",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./client": {
      "types": "./dist/src/client.d.ts",
      "import": "./dist/src/client.js"
    },
    "./fastify": {
      "types": "./dist/src/fastify.d.ts",
      "import": "./dist/src/fastify.js"
    }
  },
  "files": [
    "dist/src/",
    "README.md",
    "CHANGELOG.md",
    "MIGRATION.md",
    "PILOT.md",
    "CROSS_RUNTIME_DEMO.md",
    "PERSISTENT_DEMO.md",
    "SQLITE_DEMO.md",
    "CONFORMANCE.md",
    "RELEASING.md",
    "SECURITY.md",
    "security/npm-audit-2026-10-18.json",
    "LICENSE.md",
    "LICENSES/",
    "SPEC_REVISION",
    "RUST_REVISION",
    "CONFORMANCE_REVISION"
  ],
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint --error-on-warnings .",
    "check": "biome ci --error-on-warnings .",
    "build": "node scripts/build.mjs",
    "demo": "npm run build && node reference/quickstart.mjs",
    "measure:reference": "npm run build && node reference/measure.mjs",
    "measure:service": "npm run build && node reference/quickstart.mjs --load",
    "test": "npm run build && vitest run",
    "test:package": "npm run build && node scripts/check-package.mjs",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "release:check": "node scripts/release.mjs check",
    "version:prepare": "node scripts/release.mjs prepare",
    "test:release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "structured-headers": "2.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "fastify": "5.12.7",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "fastify": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "fastify": {
      "optional": true
    }
  }
}
